<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android"
    id="cordova-plugin-obd2"
    version="1.0.0">

    <name>OBD2 Plugin</name>
    <description>Comprehensive Cordova plugin for OBD2 car diagnostics with Alphanywhere support</description>
    <license>MIT</license>
    <keywords>cordova,obd2,obdii,car,diagnostics,bluetooth,elm327,alphanywhere</keywords>
    <repo>https://github.com/Maximusr-1975/Alpha_ODB2.git</repo>

    <engines>
        <engine name="cordova" version=">=9.0.0"/>
        <engine name="cordova-android" version=">=9.0.0"/>
        <engine name="cordova-ios" version=">=6.0.0"/>
    </engines>

    <!-- JavaScript Interface -->
    <js-module src="www/obd2.js" name="OBD2">
        <clobbers target="OBD2" />
    </js-module>

    <!-- Android Platform -->
    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="OBD2">
                <param name="android-package" value="com.alphaodb2.cordova.OBD2Plugin"/>
            </feature>
        </config-file>

        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.BLUETOOTH"/>
            <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"/>
            <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
            <uses-permission android:name="android.permission.BLUETOOTH_SCAN"/>
            <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
            <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
            <uses-feature android:name="android.hardware.bluetooth" android:required="false"/>
        </config-file>

        <source-file src="src/android/OBD2Plugin.java" target-dir="src/com/alphaodb2/cordova"/>
        <source-file src="src/android/OBD2Manager.java" target-dir="src/com/alphaodb2/cordova"/>
        <source-file src="src/android/OBD2Command.java" target-dir="src/com/alphaodb2/cordova"/>
        <source-file src="src/android/BluetoothManager.java" target-dir="src/com/alphaodb2/cordova"/>
    </platform>

    <!-- iOS Platform -->
    <platform name="ios">
        <config-file target="config.xml" parent="/*">
            <feature name="OBD2">
                <param name="ios-package" value="OBD2Plugin"/>
            </feature>
        </config-file>

        <config-file target="*-Info.plist" parent="NSBluetoothAlwaysUsageDescription">
            <string>This app needs Bluetooth to connect to OBD2 devices</string>
        </config-file>

        <config-file target="*-Info.plist" parent="NSBluetoothPeripheralUsageDescription">
            <string>This app needs Bluetooth to connect to OBD2 devices</string>
        </config-file>

        <header-file src="src/ios/OBD2Plugin.h"/>
        <source-file src="src/ios/OBD2Plugin.m"/>
        <header-file src="src/ios/OBD2Manager.h"/>
        <source-file src="src/ios/OBD2Manager.m"/>
        <header-file src="src/ios/OBD2Command.h"/>
        <source-file src="src/ios/OBD2Command.m"/>

        <framework src="CoreBluetooth.framework"/>
        <framework src="ExternalAccessory.framework"/>
    </platform>
</plugin>
